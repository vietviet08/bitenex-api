# Application
APP_NAME=Bitenex
APP_ENV=development
DEBUG=true
API_VERSION=v1
SECRET_KEY=your-super-secret-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/bitenex
DATABASE_ECHO=true

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# WebSocket
WS_MESSAGE_QUEUE_SIZE=100

# VNPAY (Sandbox)
VNP_TMN_CODE=OQ1EMD64
VNP_HASH_SECRET=YHP88BXKGPZ4TH14X883BUVGJRFAGL9X
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=bitenexuser://payment/result
VNP_IPN_URL=http://localhost:8000/api/v1/payments/webhook/vnpay

INTERNAL_API_TOKEN=
ABANDONED_CART_N8N_WEBHOOK_URL=
ABANDONED_CART_TIMEOUT_MINUTES=
ABANDONED_CART_POLL_INTERVAL_SECONDS=
ABANDONED_CART_OFFER_EXPIRY_HOURS=

# SonarQube
SONARQUBE_IMAGE=sonarqube:lts-community
SONARQUBE_PORT=9000
SONARQUBE_DB_NAME=sonarqube
SONARQUBE_DB_USER=postgres
SONARQUBE_DB_PASSWORD=postgres
SONARQUBE_JVM_XMS=512m
SONARQUBE_JVM_XMX=512m
